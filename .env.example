# OpenAI API credentials and the vision-capable model used by the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# App access. Use long, different values in production.
TEAM_PASSCODE=
ADMIN_PASSCODE=

# Optional. If blank, a stable secret report token is derived from ADMIN_PASSCODE.
SPONSOR_REPORT_TOKEN=

# Optional in local development; the app will use a local change log instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
